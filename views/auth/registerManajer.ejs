<%- include('../partials/headers/__header-auth.ejs', { title: 'Daftar Manajer' }) %>

<%- include('../partials/messages/__messages-auth.ejs') %>
    <div class="container-scroller">
        <div class="container-fluid page-body-wrapper full-page-wrapper">
        <div class="content-wrapper d-flex align-items-center justify-content-center auth px-0">
            <div class="row w-100 mx-0 justify-content-center">
            <div class="col-12 col-md-10 col-lg-6 col-xl-5 mx-auto">
                <div class="auth-form-light text-left py-5 px-4 px-sm-5">
                <div class="brand-logo">
                    <img src="../../images/assets/BRI.png" alt="logo">
                </div>
                <h4>Pendaftaran Manajer</h4>
                <form class="pt-3" action="/reg-manajer" method="POST">
                    <div class="form-group">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input type="text" class="form-control form-control-lg" id="namaInput" placeholder="Nama" name="nama" value="<%= (typeof data != 'undefined' && data.nama) || '' %>">
                    </div>
                    </div>
                    <div class="form-group">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person-vcard"></i></span>
                        <input type="text" class="form-control form-control-lg" id="nomorPegawaiInput" placeholder="Nomor Pegawai" name="nomor_pegawai" value="<%= (typeof data != 'undefined' && data.nomor_pegawai) || '' %>">
                    </div>
                    </div>
                    <div class="form-group">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input type="password" class="form-control form-control-lg" id="kataSandiInput" placeholder="Kata Sandi" name="kata_sandi" value="<%= (typeof data != 'undefined' && data.kata_sandi) || '' %>">
                        <span class="input-group-text toggle-password"><i class="bi bi-eye-slash"></i></span>
                    </div>
                    </div>
                    <div class="form-group">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input type="password" class="form-control form-control-lg" id="konfirmasiKataSandiInput" placeholder="Konfirmasi Kata Sandi" name="konfirmasi_kata_sandi" value="">
                        <span class="input-group-text toggle-password"><i class="bi bi-eye-slash"></i></span>
                    </div>
                    </div>
                    <div class="mt-3">
                    <button type="submit" class="btn btn-block btn-primary btn-lg font-weight-medium auth-form-btn">DAFTAR</button>
                    </div>
                    <div class="text-center mt-4 font-weight-light">
                    Sudah punya akun? <a href="/" class="text-primary">Masuk</a>
                    </div>
                </form>
                </div>
            </div>
            </div>
        </div>
        </div>
    </div>

<%- include('../partials/scripts/__script-auth.ejs') %>
