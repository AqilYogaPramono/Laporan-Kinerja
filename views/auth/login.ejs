<%- include('../partials/headers/__header-auth.ejs', { title: 'Masuk' }) %>

<%- include('../partials/messages/__messages-auth.ejs') %>
    <div class="container-scroller">
        <div class="container-fluid page-body-wrapper full-page-wrapper">
        <div class="content-wrapper d-flex align-items-center justify-content-center auth px-0">
            <div class="row w-100 mx-0 justify-content-center">
            <div class="col-12 col-md-10 col-lg-6 col-xl-5 mx-auto">
                <div class="auth-form-light text-left py-5 px-4 px-sm-5">
                <div class="brand-logo text-center">
                    <img src="../../images/assets/logo.webp" alt="logo">
                </div>
                <h4>Masuk</h4>
                <form class="pt-3" action="/log" method="POST">
                    <div class="form-group">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person-vcard"></i></span>
                        <input type="text" class="form-control form-control-lg" id="nomorPegawaiInput" placeholder="Nomor Pegawai" name="nomor_pegawai" value="<%= (typeof data != 'undefined' && data.nomor_pegawai) || '' %>">
                    </div>
                    </div>
                    <div class="form-group">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input type="password" class="form-control form-control-lg" id="kataSandiInput" placeholder="Kata Sandi" name="kata_sandi" value="">
                        <span class="input-group-text toggle-password"><i class="bi bi-eye-slash"></i></span>
                    </div>
                    </div>
                    <div class="mt-3">
                    <button type="submit" class="btn btn-block btn-primary btn-lg font-weight-medium auth-form-btn">MASUK</button>
                    </div>
                    <div class="text-center mt-4 font-weight-light">
                    Belum punya akun? <a href="/daftar-karyawan" class="text-primary">Daftar Karyawan</a> atau <a href="/daftar-manajer" class="text-primary">Daftar Manajer</a>
                    </div>
                </form>
                </div>
            </div>
            </div>
        </div>
        </div>
    </div>

<%- include('../partials/scripts/__script-auth.ejs') %>
