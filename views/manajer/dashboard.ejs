<%- include('../partials/headers/__header-dashboard.ejs', { title: 'Dashboard Manajer' }) %>
<%- include('../partials/navs/__nav-manajer.ejs') %>
<%- include('../partials/messages/__messages-dashboard.ejs') %>

<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title mb-4">
                Dashboard Manajer
            </h3>
        </div>
        <div class="row">
            <div class="col-12 col-sm-6 col-lg-4 grid-margin stretch-card">
                <div class="stat-card card w-100 stat-card-proses">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="flex-grow-1">
                                <div class="stat-label">
                                    Karyawan Dalam Proses
                                </div>
                                <div class="stat-number" data-count="<%= countKaryawanProses %>">
                                    <%= countKaryawanProses %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4 grid-margin stretch-card">
                <div class="stat-card card w-100 stat-card-laporan">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="flex-grow-1">
                                <div class="stat-label">
                                    Karyawan Valid
                                </div>
                                <div class="stat-number" data-count="<%= countKaryawanValid %>">
                                    <%= countKaryawanValid %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4 grid-margin stretch-card">
                <div class="stat-card card w-100 stat-card-aktif">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="flex-grow-1">
                                <div class="stat-label">
                                    Laporan Kinerja
                                </div>
                                <div class="stat-number" data-count="<%= countLaporanKinerja %>">
                                    <%= countLaporanKinerja %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/scripts/__script-dashboard.ejs') %>