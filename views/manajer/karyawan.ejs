<%- include('../partials/headers/__header-dashboard.ejs', { title: 'Data Karyawan' }) %>
<%- include('../partials/navs/__nav-manajer.ejs') %>
<%- include('../partials/messages/__messages-dashboard.ejs') %>

<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title mb-4">
                Data Karyawan
            </h3>
        </div>
        <div class="row">
            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <div>
                            <div class="karyawan-list-header">
                                <div class="karyawan-list-header-item karyawan-list-header-no">No</div>
                                <div class="karyawan-list-header-item karyawan-list-header-nama">Nama</div>
                                <div class="karyawan-list-header-item karyawan-list-header-np">Nomor Pegawai</div>
                                <div class="karyawan-list-header-item karyawan-list-header-status">Status</div>
                                <div class="karyawan-list-header-item karyawan-list-header-action"></div>
                            </div>
                            <div class="karyawan-list">
                                <% if (Array.isArray(data) && data.length) { %>
                                    <% for (let i = 0; i < data.length; i++) { %>
                                        <div class="karyawan-item">
                                            <div class="karyawan-header" data-toggle="collapse" data-target="#karyawanDetail<%= data[i].id %>" aria-expanded="false" aria-controls="karyawanDetail<%= data[i].id %>">
                                                <div class="karyawan-header-content">
                                                    <div class="karyawan-header-main">
                                                        <div class="karyawan-header-no"><%= i + 1 %></div>
                                                        <div class="karyawan-header-nama"><%= data[i].nama %></div>
                                                        <div class="karyawan-header-np"><%= data[i].nomor_pegawai %></div>
                                                        <div class="karyawan-header-status">
                                                            <% if (data[i].status === 'Aktif') { %>
                                                                <span class="badge badge-status badge-status-active">Aktif</span>
                                                            <% } else if (data[i].status === 'Proses') { %>
                                                                <span class="badge badge-status badge-status-process">Proses</span>
                                                            <% } else { %>
                                                                <span class="badge badge-status badge-status-nonactive">Non-Aktif</span>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                    <i class="mdi mdi-chevron-down karyawan-chevron"></i>
                                                </div>
                                            </div>
                                            <div class="collapse" id="karyawanDetail<%= data[i].id %>">
                                                <div class="karyawan-detail">
                                                    <div class="karyawan-detail-grid">
                                                        <div class="karyawan-detail-item">
                                                            <div class="karyawan-detail-label">Foto</div>
                                                            <div class="karyawan-detail-value">
                                                                <% if (data[i].foto_profil) { %>
                                                                    <img src="/images/karyawan/<%= data[i].foto_profil %>" alt="Foto Profil" class="karyawan-photo img-click-preview" style="width: 80px; height: 80px; object-fit: cover; border-radius: 50%; cursor: pointer;">
                                                                <% } else { %>
                                                                    <div class="bg-secondary rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                                                        <i class="mdi mdi-account text-white" style="font-size: 2rem;"></i>
                                                                    </div>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                        <div class="karyawan-detail-item">
                                                            <div class="karyawan-detail-label">Nomor WhatsApp</div>
                                                            <div class="karyawan-detail-value"><%= data[i].nomor_whatsapp || '-' %></div>
                                                        </div>
                                                        <div class="karyawan-detail-item">
                                                            <div class="karyawan-detail-label">Waktu Dibuat</div>
                                                            <div class="karyawan-detail-value">
                                                                <% if (data[i].waktu_dibuat) { %>
                                                                    <%= new Date(data[i].waktu_dibuat).toLocaleString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                                                <% } else { %>
                                                                    -
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                        <div class="karyawan-detail-item">
                                                            <div class="karyawan-detail-label">Waktu Diverifikasi</div>
                                                            <div class="karyawan-detail-value">
                                                                <% if (data[i].waktu_diverifikasi) { %>
                                                                    <%= new Date(data[i].waktu_diverifikasi).toLocaleString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                                                <% } else { %>
                                                                    -
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="karyawan-detail-actions">
                                                        <button type="button" class="btn btn-sm btn-outline-primary" data-toggle="modal" data-target="#modalEdit<%= data[i].id %>">Edit Status</button>
                                                        <% if (data[i].status === 'Non-Aktif') { %>
                                                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete" data-url="/manajer/karyawan/delete/<%= data[i].id %>">Hapus</button>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% } %>
                                <% } else { %>
                                    <div class="empty-state text-center py-4">Belum ada data</div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<% if (Array.isArray(data) && data.length) { %>
    <% for (let i = 0; i < data.length; i++) { %>
        <div class="modal fade modal-below-navbar" id="modalEdit<%= data[i].id %>" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Status Karyawan</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <form action="/manajer/karyawan/edit/<%= data[i].id %>" method="POST">
                        <div class="modal-body">
                            <div class="form-group">
                                <label for="status_<%= data[i].id %>">Status Akun</label>
                                <select class="form-control" id="status_<%= data[i].id %>" name="status" required>
                                    <option value="Aktif" <%= data[i].status === 'Aktif' ? 'selected' : '' %>>Aktif</option>
                                    <option value="Proses" <%= data[i].status === 'Proses' ? 'selected' : '' %>>Proses</option>
                                    <option value="Non-Aktif" <%= data[i].status === 'Non-Aktif' ? 'selected' : '' %>>Non-Aktif</option>
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-dismiss="modal">Batal</button>
                            <button type="submit" class="btn btn-primary">Simpan</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    <% } %>
<% } %>

<div class="modal fade modal-below-navbar" id="modalConfirmDelete" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Konfirmasi Hapus</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Apakah Anda yakin ingin menghapus karyawan ini?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-dismiss="modal">Batal</button>
                <button type="button" class="btn btn-danger" id="btnConfirmDelete">Hapus</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-top" id="globalImagePreviewModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 90vw;">
        <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
            <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close" style="position: absolute; top: -40px; right: 0; z-index: 10; font-size: 2rem; opacity: 0.9;">
                <span aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body p-0 text-center">
                <img id="globalImagePreviewEl" src="" alt="Preview" style="max-width: 100%; max-height: 85vh; border-radius: 8px; box-shadow: 0 8px 32px rgba(0,0,0,0.3);">
            </div>
        </div>
    </div>
</div>

<%- include('../partials/scripts/__script-dashboard.ejs') %>