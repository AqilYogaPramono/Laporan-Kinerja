<%- include('../../partials/headers/__header-dashboard.ejs', { title: 'Detail Laporan Kinerja' }) %>
<%- include('../../partials/navs/__nav-karyawan.ejs') %>
<%- include('../../partials/messages/__messages-dashboard.ejs') %>

<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title mb-4">
                Detail Laporan Kinerja
            </h3>
        </div>
        <div class="row">
            <div class="col-12 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <div class="detail-header mb-3">
                    <h4 class="card-title mb-0 detail-title"><%= laporanKinerjaData.judul_laporan %></h4>
                    <div class="detail-actions">
                      <a href="/karyawan/dokumen-kinerja/buat-dokumen/<%= laporanKinerjaData.id %>" class="btn btn-primary btn-sm">Tambah Dokumen</a>
                      <a href="/karyawan/dokumen-kinerja/buat-link/<%= laporanKinerjaData.id %>" class="btn btn-success btn-sm">Tambah Link</a>
                      <a href="/karyawan/laporan-kinerja" class="btn btn-light btn-sm">Kembali</a>
                    </div>
                  </div>
                  <div class="mb-4">
                    <p class="mb-2"><strong>Dibuat Oleh:</strong> <%= laporanKinerjaData.dibuat_oleh %></p>
                    <p class="mb-2"><strong>Dibuat Pada:</strong> <%= laporanKinerjaData.dibuat_pada ? new Date(laporanKinerjaData.dibuat_pada).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-' %></p>
                    <% if (laporanKinerjaData.terakhir_diedit_oleh) { %>
                      <p class="mb-2"><strong>Terakhir Diedit Oleh:</strong> <%= laporanKinerjaData.terakhir_diedit_oleh %></p>
                      <p class="mb-2"><strong>Terakhir Diedit Pada:</strong> <%= laporanKinerjaData.terakhir_diedit_pada ? new Date(laporanKinerjaData.terakhir_diedit_pada).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-' %></p>
                    <% } %>
                  </div>
                  <hr>
                  <h5 class="mb-3">Dokumen Kinerja</h5>
                  <div>
                    <% if (Array.isArray(dokumenKinerjaData) && dokumenKinerjaData.length) { %>
                      <table class="table table-hover table-stacked">
                        <thead>
                          <tr>
                            <th>No</th>
                            <th>Nama File</th>
                            <th>Tipe</th>
                            <th>Dibuat Oleh</th>
                            <th>Dibuat Pada</th>
                            <th style="width: 200px;" class="text-right">Aksi</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% dokumenKinerjaData.forEach(function(item, index){ %>
                            <tr>
                              <td data-label="No"><%= index + 1 %></td>
                              <td data-label="Nama File"><%= item.nama_file %></td>
                              <td data-label="Tipe"><%= item.tipe_file %></td>
                              <td data-label="Dibuat Oleh"><%= item.dibuat_oleh %></td>
                              <td data-label="Dibuat Pada"><%= item.dibuat_pada ? new Date(item.dibuat_pada).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '-' %></td>
                              <td class="text-right" data-label="Aksi">
                                <div class="btn-actions">
                                  <% if (item.tipe_file === 'Dokumen') { %>
                                    <a href="/documents/laporanDokumen/<%= item.file %>" download class="btn btn-sm btn-outline-primary">Download</a>
                                  <% } else { %>
                                    <a href="<%= item.file %>" target="_blank" class="btn btn-sm btn-outline-primary">Buka Link</a>
                                  <% } %>
                                  <% if (item.id_karyawan == userId) { %>
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-delete-dokumen" data-url="/karyawan/dokumen-kinerja/hapus/<%= item.id %>">Hapus</button>
                                  <% } %>
                                </div>
                              </td>
                            </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    <% } else { %>
                      <p class="text-center text-muted">Belum ada dokumen kinerja</p>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-below-navbar" id="modalConfirmDeleteDokumen" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Konfirmasi Hapus</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        Apakah Anda yakin ingin menghapus dokumen kinerja ini?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-danger" id="btnConfirmDeleteDokumen">Hapus</button>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/scripts/__script-dashboard.ejs') %>

