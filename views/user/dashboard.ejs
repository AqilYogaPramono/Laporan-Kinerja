<%- include('../partials/headers/__header-dashboard.ejs', { title: 'Dashboard User' }) %>
<%- include('../partials/navs/__nav-user.ejs') %>
<%- include('../partials/messages/__messages-dashboard.ejs') %>

<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title mb-4">
                Dashboard User
            </h3>
        </div>
        <div class="row">
            <div class="col-12 col-sm-6 col-lg-6 grid-margin stretch-card">
                <div class="stat-card card w-100 stat-card-aktif">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="flex-grow-1">
                                <div class="stat-label">
                                    Laporan Kinerja Tim
                                </div>
                                <div class="stat-number" data-count="<%= countLaporanKinerjaInOneTeamById %>">
                                    <%= countLaporanKinerjaInOneTeamById %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-6 grid-margin stretch-card">
                <div class="stat-card card w-100 stat-card-aktif">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="flex-grow-1">
                                <div class="stat-label">
                                    Dokumen Kinerja
                                </div>
                                <div class="stat-number" data-count="<%= countDokumenKinerjaById %>">
                                    <%= countDokumenKinerjaById %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/scripts/__script-dashboard.ejs') %>