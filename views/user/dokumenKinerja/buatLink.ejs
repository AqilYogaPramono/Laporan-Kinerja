<%- include('../../partials/headers/__header-dashboard.ejs', { title: 'Tambah Link Kinerja' }) %>
<%- include('../../partials/navs/__nav-user.ejs') %>
<%- include('../../partials/messages/__messages-dashboard.ejs') %>

<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title mb-4">
                Tambah Link Kinerja
            </h3>
        </div>
        <div class="row">
            <div class="col-12 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <p class="card-description">Tambahkan link untuk laporan kinerja: <strong><%= laporanKinerjaData.judul_laporan %></strong></p>
                  <form action="/user/dokumen-kinerja/buat-link/<%= laporanKinerjaData.id %>" method="POST" data-loading>
                    <div class="form-group">
                      <label for="nama_file">Nama File</label>
                      <input type="text" class="form-control" id="nama_file" name="nama_file" placeholder="Masukkan nama file" value="<%= (typeof data != 'undefined' && data.nama_file) || '' %>" required>
                    </div>
                    <div class="form-group">
                      <label for="file">Link</label>
                      <input type="url" class="form-control" id="file" name="file" placeholder="Masukkan link" value="<%= (typeof data != 'undefined' && data.file) || '' %>" required>
                    </div>
                    <div class="d-flex">
                      <button type="submit" class="btn btn-primary mr-2">Simpan</button>
                      <a href="/user/dokumen-kinerja/detail/<%= laporanKinerjaData.id %>" class="btn btn-light">Kembali</a>
                    </div>
                  </form>
                </div>
              </div>
            </div>
        </div>
    </div>
</div>

<%- include('../../partials/scripts/__script-dashboard.ejs') %>