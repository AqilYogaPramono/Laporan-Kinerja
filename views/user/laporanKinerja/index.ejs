<%- include('../../partials/headers/__header-dashboard.ejs', { title: 'Laporan Kinerja' }) %>
<%- include('../../partials/navs/__nav-user.ejs') %>
<%- include('../../partials/messages/__messages-dashboard.ejs') %>

<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title mb-4">
                Laporan Kinerja
            </h3>
        </div>
        <div class="row">
            <div class="col-lg-12 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="card-title mb-0">Daftar Laporan Kinerja</h4>
                    <% if (typeof userRole !== 'undefined' && userRole === 'Ketua') { %>
                      <a href="/user/laporan-kinerja/buat" class="btn btn-primary btn-sm">Buat Laporan</a>
                    <% } %>
                  </div>
                  <div>
                    <table class="table table-hover table-stacked">
                      <thead>
                        <tr>
                          <th>No</th>
                          <th>Judul Laporan</th>
                          <th>Dibuat Oleh</th>
                          <th>Dibuat Pada</th>
                          <th>Terakhir Diedit Oleh</th>
                          <th style="width: 160px;" class="text-right">Aksi</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (Array.isArray(data) && data.length) { %>
                          <% data.forEach(function(item, index){ %>
                            <tr>
                              <td data-label="No"><%= index + 1 %></td>
                              <td data-label="Judul Laporan"><%= item.judul_laporan %></td>
                              <td data-label="Dibuat Oleh"><%= item.dibuat_oleh %></td>
                              <td data-label="Dibuat Pada"><%= item.dibuat_pada ? new Date(item.dibuat_pada).toLocaleString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-' %></td>
                              <td data-label="Terakhir Diedit Oleh"><%= item.terakhir_diedit_oleh || '-' %></td>
                              <td class="text-right" data-label="Aksi">
                                <div class="btn-actions">
                                  <a href="/user/dokumen-kinerja/detail/<%= item.id %>" class="btn btn-sm btn-outline-primary">Detail</a>
                                </div>
                              </td>
                            </tr>
                          <% }) %>
                        <% } else { %>
                          <tr>
                            <td colspan="6" class="text-center empty-state">Belum ada data</td>
                          </tr>
                        <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
        </div>
    </div>
</div>

<%- include('../../partials/scripts/__script-dashboard.ejs') %>