<%- include('../../partials/headers/__header-dashboard.ejs', { title: 'Buat Laporan Kinerja' }) %>
<%- include('../../partials/navs/__nav-user.ejs') %>
<%- include('../../partials/messages/__messages-dashboard.ejs') %>

<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title mb-4">
                Buat Laporan Kinerja
            </h3>
        </div>
        <div class="row">
            <div class="col-12 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <p class="card-description">Masukkan judul laporan kinerja yang akan dibuat</p>
                  <form action="/user/laporan-kinerja/buat" method="POST" data-loading>
                    <div class="form-group">
                      <label for="judul_laporan">Judul Laporan</label>
                      <input type="text" class="form-control" id="judul_laporan" name="judul_laporan" placeholder="Masukkan judul laporan" value="<%= (typeof data != 'undefined' && data.judul_laporan) || '' %>" required>
                    </div>
                    <div class="d-flex">
                      <button type="submit" class="btn btn-primary mr-2">Simpan</button>
                      <a href="/user/laporan-kinerja" class="btn btn-light">Kembali</a>
                    </div>
                  </form>
                </div>
              </div>
            </div>
        </div>
    </div>
</div>

<%- include('../../partials/scripts/__script-dashboard.ejs') %>