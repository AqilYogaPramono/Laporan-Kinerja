<%- include('../../partials/headers/__header-dashboard.ejs', { title: 'Laporan Kinerja' }) %>
<%- include('../../partials/navs/__nav-admin.ejs') %>
<%- include('../../partials/messages/__messages-dashboard.ejs') %>

<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title mb-4">
                Laporan Kinerja
            </h3>
        </div>
        <div class="row">
            <div class="col-lg-12 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="card-title mb-0">Daftar Laporan Kinerja</h4>
                  </div>
                  <div>
                    <table class="table table-hover table-stacked">
                      <thead>
                        <tr>
                          <th>No</th>
                          <th>Judul Laporan</th>
                          <th>Dibuat Oleh</th>
                          <th>Dibuat Pada</th>
                          <th>Terakhir Diedit Oleh</th>
                          <th style="width: 160px;" class="text-right">Aksi</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (Array.isArray(data) && data.length) { %>
                          <% data.forEach(function(item, index){ %>
                            <tr>
                              <td data-label="No"><%= index + 1 %></td>
                              <td data-label="Judul Laporan"><%= item.judul_laporan %></td>
                              <td data-label="Dibuat Oleh"><%= item.dibuat_oleh %></td>
                              <td data-label="Dibuat Pada"><%= item.dibuat_pada ? new Date(item.dibuat_pada).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '-' %></td>
                              <td data-label="Terakhir Diedit Oleh"><%= item.terakhir_diedit_oleh || '-' %></td>
                              <td class="text-right" data-label="Aksi">
                                <div class="btn-actions">
                                  <a href="/admin/laporan-kinerja/detail/<%= item.id %>" class="btn btn-sm btn-outline-primary">Detail</a>
                                </div>
                              </td>
                            </tr>
                          <% }) %>
                        <% } else { %>
                          <tr>
                            <td colspan="6" class="text-center empty-state">Belum ada data</td>
                          </tr>
                        <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-below-navbar" id="modalConfirmDelete" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Konfirmasi Hapus</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        Apakah Anda yakin ingin menghapus laporan kinerja ini?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-danger" id="btnConfirmDelete">Hapus</button>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/scripts/__script-dashboard.ejs') %>