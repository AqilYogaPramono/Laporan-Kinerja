<%- include('../../partials/headers/__header-dashboard.ejs', { title: 'Data User' }) %>
<%- include('../../partials/navs/__nav-Admin.ejs') %>
<%- include('../../partials/messages/__messages-dashboard.ejs') %>

<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title mb-4">
                Data User
            </h3>
        </div>
        <div class="row">
            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <div class="row mb-4 justify-content-end">
                            <div class="col-md-6 col-lg-4">
                                <form action="/admin/users/search" method="POST">
                                    <div class="google-search-box">
                                        <input type="text" class="google-search-input" name="nomor_pegawai" placeholder="Cari Nomor Pegawai..." value="<%= typeof searchKeyword !== 'undefined' ? searchKeyword : '' %>" required>
                                        <div class="google-search-actions">
                                            <% if (typeof searchKeyword !== 'undefined' && searchKeyword) { %>
                                                <a href="/admin/users" class="google-search-clear" title="Hapus Pencarian">&times;</a>
                                                <span class="google-search-divider"></span>
                                            <% } %>
                                            <button class="google-search-btn" type="submit" title="Cari">
                                                <i class="mdi mdi-magnify"></i>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div>
                            <table class="table table-hover table-stacked">
                                <thead>
                                    <tr>
                                        <th>No</th>
                                        <th>Nama</th>
                                        <th>Nomor Pegawai</th>
                                        <th>Nama Tim</th>
                                        <th>Jabatan</th>
                                        <th>Status</th>
                                        <th style="width: 120px;" class="text-right">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (Array.isArray(data) && data.length) { %>
                                        <% for (let i = 0; i < data.length; i++) { %>
                                            <tr>
                                                <td data-label="No"><%= i + 1 %></td>
                                                <td data-label="Nama"><%= data[i].nama %></td>
                                                <td data-label="Nomor Pegawai"><%= data[i].nomor_pegawai %></td>
                                                <td data-label="Nama Tim"><%= data[i].nama_tim || '-' %></td>
                                                <td data-label="Jabatan"><%= data[i].jabatan || '-' %></td>
                                                <td data-label="Status">
                                                    <% if (data[i].status === 'Aktif') { %>
                                                        <span class="badge badge-status badge-status-active">Aktif</span>
                                                    <% } else if (data[i].status === 'Proses') { %>
                                                        <span class="badge badge-status badge-status-process">Proses</span>
                                                    <% } else { %>
                                                        <span class="badge badge-status badge-status-nonactive">Non-Aktif</span>
                                                    <% } %>
                                                </td>
                                                <td class="text-right" data-label="Aksi">
                                                    <div class="btn-actions">
                                                        <a href="/admin/users/<%= data[i].id %>" class="btn btn-sm btn-outline-info">Detail</a>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% } %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="text-center empty-state">Belum ada data</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../../partials/scripts/__script-dashboard.ejs') %>